Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /State odom1/Shape1
        - /Marker1/Topic1
      Splitter Ratio: 0.5
    Tree Height: 712
  - Class: rviz_common/Selection
